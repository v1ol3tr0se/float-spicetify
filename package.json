{
	"name": "float-spicetify",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "node --disable-warning=ExperimentalWarning build.ts",
		"typecheck": "tsc",
		"lint": "biome check .",
		"format": "biome check --write .",
		"verify": "yarn typecheck && yarn lint && yarn build --check"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@types/node": "^26.6.5",
		"typescript": "^7.0.2"
	},
	"packageManager": "yarn@1.22.22"
}
