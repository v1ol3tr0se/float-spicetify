{
	"compilerOptions": {
		"target": "es2024",
		"lib": ["es2024", "dom"],
		"module": "nodenext",
		"types": ["node"],
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["src", "build.ts"]
}
